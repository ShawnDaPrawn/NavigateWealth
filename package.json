  "scripts": {
    "dev": "vite",
    "prepare": "husky",
    "build": "node ./scripts/build/copy-pdfjs-assets.mjs && node ./scripts/build/generate-figma-webp.mjs && node ./scripts/seo/generate-seo-files.mjs && vite build && node ./scripts/seo/apply-static-seo.mjs && node ./scripts/seo/verify-seo-build.mjs",
    "pdfjs:assets": "node ./scripts/build/copy-pdfjs-assets.mjs",
    "seo:verify": "node ./scripts/seo/generate-seo-files.mjs && node ./scripts/seo/verify-seo-build.mjs",
    "bundle:check": "node ./scripts/build/check-bundle-size.mjs",
    "optimize:images": "node ./scripts/brand/optimize-images.mjs",
    "ui:inspect": "node ./scripts/dev/ui-inspect.mjs",
    "provider:sync": "node ./scripts/provider-portal-worker.mjs",
    "provider:watch": "set NW_PLAYWRIGHT_HEADED=1&& set NW_PLAYWRIGHT_RECORD_VIDEO=1&& set NW_PLAYWRIGHT_RECORD_TRACE=1&& set NW_PORTAL_DEBUG_DIR=tmp/provider-portal-worker&& node ./scripts/provider-portal-worker.mjs",
    "provider:worker": "node ./scripts/provider-portal-worker.mjs --poll",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:middleware": "tsc --noEmit -p tsconfig.middleware.json",
    "typecheck:deno": "deno check --config src/supabase/functions/server/deno.json src/supabase/functions/server/index.tsx",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage:server": "vitest run --coverage --config quality/vitest.config.server.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/public-render-smoke.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "fna-intake:backfill": "node ./scripts/uat/fna-intake-backfill.mjs",
    "fna-intake:bootstrap-uat": "node ./scripts/uat/fna-intake-bootstrap-uat-actors.mjs",
    "fna-intake:api-uat": "node ./scripts/uat/fna-intake-api-uat.mjs",
    "fna-intake:uat-report": "node ./scripts/uat/fna-intake-uat-report.mjs",
    "deploy:smoke": "node ./scripts/ops/post-deploy-smoke.mjs",
    "metrics": "node ./scripts/ops/metrics-report.mjs",
    "form-prefill:smoke": "node ./scripts/uat/form-prefill-api-smoke.mjs",
    "form-prefill:e2e": "playwright test e2e/form-prefill-smoke.spec.ts --project=desktop-chromium",
    "form-prefill:migrate-templates": "node ./scripts/ops/migrate-form-templates-to-storage.mjs",
    "depcruise": "npx dependency-cruiser@16 \"src/**/*.{ts,tsx}\" --config quality/dependency-cruiser.cjs",
    "figma:webp": "node ./scripts/build/generate-figma-webp.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yml,yaml}": "prettier --write"
  }
}
