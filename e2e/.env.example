PLAYWRIGHT_BASE_URL=http://localhost:3000

# Admin login used by sender.spec.ts and form-prefill E2E (/admin requires approved admin).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Form prefill API smoke + optional client drawer deep link in Playwright.
E2E_FNA_ADVISER_EMAIL=
E2E_FNA_ADVISER_PASSWORD=
E2E_FNA_CLIENT_ID=

# Signer tokens are single-use access codes pulled from the magic-link
# emitted when an envelope is sent. Generate two so signer + decline
# specs can run in any order without colliding.
E2E_SIGNER_TOKEN=
E2E_SIGNER_DECLINE_TOKEN=
