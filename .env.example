# ============================================================================
# Navigate Wealth — environment variable reference
# ============================================================================
#
# Copy to `.env.local` for local dev and fill in real values. `.env.local`,
# `.env.*.local`, and `*.secret.local` are git-ignored — NEVER commit secrets.
#
# This file documents EVERY variable the code reads. It is grouped by where the
# variable is consumed. NOT every var is needed in every environment:
#   • Frontend (VITE_*)  — baked into the browser bundle at build time. Only
#                          put NON-secret, publishable values here (anon keys,
#                          public URLs, feature flags). Anything secret in a
#                          VITE_* var is shipped to every visitor.
#   • Build/SEO scripts  — read at `npm run build` (Node).
#   • Edge Function      — set in Supabase ("supabase secrets set" or the
#                          dashboard), NOT in this local file. SUPABASE_URL /
#                          SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are
#                          auto-injected by the Supabase runtime in production;
#                          you only set them locally to run scripts/tests.
#   • Portal worker      — the standalone Playwright worker (scripts + Docker).
#   • E2E tests          — Playwright specs.
#
# Values below are PLACEHOLDERS. Replace before use.

# ----------------------------------------------------------------------------
# Frontend (Vite — browser bundle, build time). Publishable values only.
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"           # publishable (RLS-protected)
VITE_SITE_URL="https://www.navigatewealth.co"
VITE_GOOGLE_SITE_VERIFICATION=""                          # Google Search Console token

# ----------------------------------------------------------------------------
# Build / SEO scripts (Node — scripts/generate-seo-files.mjs, apply-static-seo.mjs)
# ----------------------------------------------------------------------------
SITE_URL="https://www.navigatewealth.co"
SEO_REQUIRE_ARTICLES="false"        # true = fail the build if the article feed can't be fetched
SITEMAP_TIMEZONE="Africa/Johannesburg"
GOOGLE_SITE_VERIFICATION=""
PUBLIC_SUPABASE_ANON_KEY=""         # alt anon key some scripts read
SUPABASE_FUNCTIONS_BASE_URL="https://YOUR-PROJECT-REF.supabase.co/functions/v1"
SUPABASE_PROJECT_REF="YOUR-PROJECT-REF"
QUALITY_ISSUES_INGEST_URL=""        # CI quality-report ingest endpoint (publish-quality-report.mjs)
QUALITY_SECURITY_REPORT_PATH=""     # optional path to a security report to attach

# ----------------------------------------------------------------------------
# Supabase Edge Function (set via `supabase secrets set`, NOT committed here)
# ----------------------------------------------------------------------------
# Auto-injected by Supabase in prod; set locally only for scripts/tests:
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # SECRET — full DB access, never expose to the browser
SUPABASE_ANON_KEY="your-supabase-anon-key"
DENO_ENV="production"               # controls error-detail verbosity (error.middleware.ts)

# Security / access control:
NW_ALLOWED_ORIGINS="https://www.navigatewealth.co,https://navigatewealth.co"  # CORS allow-list. MUST be set in prod — unset = permissive fallback (see index.tsx §CORS)
SUPER_ADMIN_PASSWORD=""             # super-admin bootstrap/login password
CRON_SECRET=""                      # shared secret guarding cron-triggered routes

# AI providers:
OPENAI_API_KEY=""
NW_GOOGLE_AI_API_KEY=""             # preferred Google AI key (falls back to GEMINI_API_KEY / GOOGLE_API_KEY)
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
NW_PORTAL_BRAIN_MODEL=""            # "portal brain" LLM model id
NW_PORTAL_BRAIN_API_BASE=""
NW_PORTAL_BRAIN_ENABLED="false"

# Email / SMS:
SENDGRID_API_KEY=""
SMS_PROVIDER=""                     # "twilio" | "clickatell"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
CLICKATELL_API_KEY=""

# Stripe Treasury + Issuing (Locked → Accounts → Manager panel):
#   Set via `supabase secrets set …` — never committed. Server-side only.
#   This deployment's key belongs to a Connect *platform* that issues for its
#   connected accounts (issuing-on-Connect). In that setup:
#     • STRIPE_CONNECTED_ACCOUNT_ID is REQUIRED — Issuing/Treasury calls made on
#       the platform itself are rejected ("you can only issue cards for your
#       connected accounts"). Set it to the connected account that has the
#       card_issuing capability active (currently acct_1KafO12HqLs4GBv0,
#       "Direct Financial Planning").
#     • STRIPE_FINANCIAL_ACCOUNT_ID must be set ONLY when that connected account
#       has Treasury enabled; the card is then backed by that financial account.
#       Leave it BLANK when the connected account has no Treasury — cards then
#       draw from the connected account's Issuing balance. Never point it at the
#       platform's own FA (a platform FA can't back a card).
STRIPE_SECRET_KEY=""                 # sk_… platform secret key
STRIPE_CONNECTED_ACCOUNT_ID=""       # acct_… connected account scoped via Stripe-Account (required here)
STRIPE_FINANCIAL_ACCOUNT_ID=""       # fa_… connected account's Treasury FA — only if Treasury is enabled

# Third-party integrations:
HONEYCOMB_API_KEY=""
UNSPLASH_ACCESS_KEY=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# E-sign data migration flags:
ESIGN_DUAL_WRITE="false"            # mirror writes to Postgres during KV→PG migration
ESIGN_READ_FROM="kv"                # "kv" | "postgres"
FORM_TEMPLATE_ALLOW_KV_FALLBACK="true"

# Privileged-role allowlists (SECURITY: PR #106 review P1):
# The auth middleware only grants admin/super_admin/adviser from
# server-controlled app_metadata.role or these email allowlists — NEVER from
# client-editable user_metadata. After deploying the role hardening, either
# run `node ./scripts/backfill-trusted-roles.mjs` (copies existing staff roles
# into app_metadata) or list admin emails here as the deploy-free fallback.
SUPER_ADMIN_EMAILS=""               # extra super-admins (comma-separated; merged with the hardcoded set)
NW_ADMIN_EMAILS=""                  # admins granted by email when app_metadata.role is not yet backfilled

# E-sign platform signing certificate (SECURITY-AUDIT H-5):
# When both are set, the PDF signer uses this P12 instead of the KV-cached one,
# keeping private-key material out of application-readable storage. Set these
# as Supabase Edge Function secrets, then delete the KV entry
# esign_config:platform_signing_cert and rotate the old key.
NW_ESIGN_PLATFORM_P12_BASE64=""     # base64-encoded PKCS#12 archive
NW_ESIGN_PLATFORM_P12_PASSPHRASE=""

# GitHub Actions dispatch (triggers the provider-portal-worker workflow):
NW_GITHUB_ACTIONS_TOKEN=""          # preferred (falls back to GITHUB_ACTIONS_DISPATCH_TOKEN)
GITHUB_ACTIONS_DISPATCH_TOKEN=""
NW_GITHUB_ACTIONS_REPO="ShawnDaPrawn/NavigateWealth"
NW_GITHUB_ACTIONS_WORKFLOW_ID="provider-portal-worker.yml"
NW_GITHUB_ACTIONS_REF="main"
NW_GITHUB_ACTIONS_API_BASE="https://api.github.com"

# Portal worker / OpenClaw gateway secrets (server side of the worker handshake):
NW_PORTAL_WORKER_SECRET=""          # preferred (falls back to PORTAL_WORKER_SECRET)
PORTAL_WORKER_SECRET=""
NW_OPENCLAW_GATEWAY_SECRET=""       # preferred (falls back to OPENCLAW_GATEWAY_SECRET)
OPENCLAW_GATEWAY_SECRET=""
NW_OPENCLAW_ALLOWED_CAPABILITIES="" # comma-separated capability allow-list

# Quality dashboard ingest (also used by CI):
QUALITY_ISSUES_INGEST_TOKEN=""

# ----------------------------------------------------------------------------
# Provider portal worker (scripts/provider-portal-worker.mjs + Dockerfile)
# ----------------------------------------------------------------------------
NW_API_BASE="https://YOUR-PROJECT-REF.supabase.co/functions/v1"
NW_API_AUTH_TOKEN=""                # bearer token the worker uses to call the API
NW_PORTAL_MODE=""                   # worker run mode
NW_PORTAL_POLL="false"              # true = long-poll loop (provider:worker)
NW_PORTAL_WORKER_ID=""
NW_PORTAL_JOB_ID=""                 # process a single job and exit
NW_PORTAL_FORCE_STAGE=""
NW_PORTAL_DEBUG_DIR=""              # dir for traces/videos/screenshots
NW_PORTAL_CLOUDFLARE_TIMEOUT_MS="30000"
NW_PORTAL_LIVE_VIEW_INTERVAL_MS=""
NW_PORTAL_SHADOW_EXTRACT=""          # 1 = observe-only LLM page-extraction comparison
NW_PLAYWRIGHT_HEADED="0"            # 1 = headed browser (provider:watch)
NW_PLAYWRIGHT_RECORD_VIDEO="0"
NW_PLAYWRIGHT_RECORD_TRACE="0"
NW_PLAYWRIGHT_MAX_PAGES=""

# ----------------------------------------------------------------------------
# E2E tests (Playwright — e2e/*.spec.ts)
# ----------------------------------------------------------------------------
E2E_FNA_ADVISER_EMAIL=""
E2E_FNA_ADVISER_PASSWORD=""
E2E_FNA_CLIENT_ID=""
ADMIN_EMAIL=""                      # test/admin actor for scripted flows
ADMIN_PASSWORD=""
