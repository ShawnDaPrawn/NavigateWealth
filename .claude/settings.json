{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__github",
      "mcp__Supabase",
      "mcp__Vercel",
      "mcp__Claude_Code_Remote",
      "mcp__Claude_Docs",
      "mcp__Buffer",
      "mcp__Figma",
      "mcp__Gmail",
      "mcp__Microsoft_365",
      "mcp__Twilio",
      "mcp__ICD-10_Codes"
    ],
    "ask": [
      "mcp__Vercel__buy_addon",
      "mcp__Vercel__buy_credits",
      "mcp__Vercel__buy_credits_endpoint",
      "mcp__Vercel__buy_domain",
      "mcp__Vercel__buy_domains",
      "mcp__Vercel__buy_pro",
      "mcp__Vercel__buy_single_domain",
      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project"
    ],
    "deny": ["mcp__Supabase__deploy_edge_function", "Bash(supabase functions deploy *)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
